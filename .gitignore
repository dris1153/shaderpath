# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
plans/

# testing
/coverage
/playwright-report/
/test-results/

# user progress database (spec §2)
/data/

# next.js
/.next/
/out/

# production
/build

# local agent state (the project skills are shared)
/.claude/*
!/.claude/skills/

# lesson videos: renders, voice/timing output and the TTS cache stay local
/video/node_modules/
/video/out/
/video/.cache/
/video/public/generated/*
!/video/public/generated/dummy/
!/video/public/generated/style/

# site dubs: generated from content/lessons/*/*/youtube/languages/*/site.mp3 by `pnpm sync:dubs`
/public/videos/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch dir for gen:shots:three
.tmp-three-shots/

# finished videos and the full upload kit (not pushed; mirrors content/)
/media/
# videos never go to git, even if copied into a lesson folder by hand
content/**/*.mp4
# the one exception: the shared outro clip every lesson is joined with
!content/shared/outro/outro.mp4

# agent notes under video/
/video/.claude/

# half-written voice files if a tts run was interrupted
/video/public/generated/dummy/**/voice.mix.wav
/video/public/generated/dummy/**/voice.tmp.mp3
/video/public/generated/dummy/**/voice.probe.wav
