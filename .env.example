# ---------------------------------------------------------------------------
# Runtime connection. Supabase -> Project Settings -> Database -> Connection
# string -> "Transaction pooler". Port 6543.
#
# Serverless functions must use the pooler: each invocation opens its own
# connection, and the direct connection exhausts Postgres' limit under even
# light traffic. db/client.ts detects ":6543" and switches to max=1 with
# prepared statements disabled, which the transaction pooler requires.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------------------
# Migrations only (pnpm db:migrate). DDL through the transaction pooler is not
# safe, so the migrator takes a session-mode connection instead — same host,
# port 5432. Supabase's "Direct connection" (db.PROJECT_REF.supabase.co:5432)
# also works, but it is IPv6-only on newer projects, so the session pooler is
# the safer default.
#
# Not needed at runtime: leave it out of the Vercel runtime env if you run
# migrations from your machine.
# ---------------------------------------------------------------------------
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Local test databases. scripts/test-db.ts starts the Docker container and
# recreates these on every run, so you only set them to point somewhere else.
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL="postgres://postgres:dev@localhost:55432/shaderpath_test"
# E2E_DATABASE_URL="postgres://postgres:dev@localhost:55432/shaderpath_e2e"
